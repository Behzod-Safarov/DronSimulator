MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1243434710}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 638f4b14d151b75429cd74927a51ef93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemolitionLesson
  title: Speed hit - 12 m/s
  instructions: Hit the BLUE car (middle bay) at 12 m/s or faster. Build speed on
    a long straight approach, stay low, and don't flare before impact.
  discipline: Demolition
  goal: Hit the BLUE car at 12 m/s or faster. You have 3 drones.
  steps:
  - Arm and fly well away from the car to make room.
  - Turn back and accelerate along a long straight line.
  - Keep the SPD readout above 12 m/s.
  - Hold that line into the blue car without flaring.
  skill: Building and holding speed on an approach, and reading your own speed display.
  tip: Lifting the nose just before impact kills your speed. Stay low, stay committed,
    and watch SPD in the top-left corner.
  controls: arrow keys = tilt,   W / S = throttle,   SPD shows your speed
  difficulty: 3
  spawn: {fileID: 1158245829}
  venue: Demolition yard
  recommendedMode: 0
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
