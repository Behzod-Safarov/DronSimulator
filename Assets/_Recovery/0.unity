--- !u!114 &1670520271
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1670520269}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ba1ba751623bed4ca7f3782962e106d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OrbitLesson
  title: Orbit the pylon
  instructions: Fly 2 full circles around the red-and-white pylon, staying 3-8 m
    from it and above 1 m. Yaw to keep the nose on the pylon while rolling around
    it.
  discipline: Basics
  goal: Fly 2 full circles around the striped pylon, staying 3-8 m from it and above
    1 m.
  steps:
  - Arm, climb to about 3 m and fly out to one side of the pylon.
  - Roll gently to start moving sideways around it.
  - At the same time hold a little yaw so the nose stays on the pylon.
  - Keep the distance between 3 and 8 m for two full laps.
  skill: Coordinating yaw with roll - the turn that lets you follow a subject or
    a track.
  tip: Rolling alone makes you drift away from the pylon. Add a little yaw all the
    way round so the nose keeps pointing at it.
  controls: A / D = yaw (turn),   arrow keys = tilt,   W / S = throttle
  difficulty: 2
  spawn: {fileID: 0}
  venue: Pit field
  recommendedMode: 0
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  pylon: {fileID: 879847084}
  minRadius: 3
  maxRadius: 8
  minHeight: 1
  laps: 2
