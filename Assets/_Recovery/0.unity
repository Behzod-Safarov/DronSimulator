--- !u!114 &1200672475
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1200672473}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ae3655ddbf706b48a9d79bc91341cc3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoverBoxLesson
  title: Hover in the box
  instructions: Arm, lift off and hold the drone inside the yellow box for 10 seconds
    without leaving it. A 5" quad hovers at ~35% throttle - small stick inputs!
  discipline: Basics
  goal: Lift off, then keep the drone inside the yellow box for 10 seconds.
  steps:
  - Throttle at the bottom, then press SPACE to arm. The props spin slowly.
  - Raise the throttle gently with W until the drone leaves the ground, at about
    35%.
  - Nudge the arrow keys to slide across into the yellow box.
  - Hold it inside for 10 seconds, correcting early with tiny inputs.
  skill: Throttle control - holding a steady height is the first thing every pilot
    must own.
  tip: Students push the throttle too far and shoot past the box. Move it a little,
    then wait a moment to see the result.
  controls: W / S = throttle (up / down),   arrow keys = tilt,   SPACE = arm
  difficulty: 1
  spawn: {fileID: 0}
  venue: Pit field
  recommendedMode: 0
  parTime: 30
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  zone: {fileID: 639941862}
  requiredSeconds: 10
  idleColor: {r: 1, g: 0.85, b: 0.2, a: 0.25}
  insideColor: {r: 0.2, g: 1, b: 0.3, a: 0.35}
