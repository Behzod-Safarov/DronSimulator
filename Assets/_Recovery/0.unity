  m_Script: {fileID: 11500000, guid: 638f4b14d151b75429cd74927a51ef93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemolitionLesson
  title: Hit the marked car
  instructions: Only the RED target car counts (leftmost bay, spinning marker). Fly
    into it. Hitting anything else wastes a drone. Fewer drones used = more stars.
  discipline: Demolition
  goal: Fly into the RED car only. You have 3 drones.
  steps:
  - Arm and climb a few metres.
  - Find the RED car - the one with the spinning orange marker.
  - Line up on it from a distance and fly straight in.
  - Fewer drones used = more stars.
  skill: Committing to a chosen target and hitting it accurately.
  tip: Hitting anything else wastes a drone. Identify the red car by its spinning
    orange marker before you accelerate.
  controls: arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 2
  spawn: {fileID: 1158245829}
  venue: Demolition yard
  recommendedMode: 0
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
