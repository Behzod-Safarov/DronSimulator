--- !u!114 &1748060431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1748060429}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a87082d4d123cf489e617881f6313ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GateCourseLesson
  title: Gate course
  instructions: Fly through the gates in order. The next gate glows green. Use yaw
    to turn and pitch to move forward.
  discipline: Racing
  goal: Fly through all 8 gates in order. The next gate glows green.
  steps:
  - Arm and climb to gate height, about 2 m.
  - Find the gate glowing green - that is your next one.
  - Yaw to point at it, then tilt forward to fly through the middle.
  - Straight after passing, turn towards the next one.
  skill: Reading a course and lining up on a target - aim at the gate before you
    reach it.
  tip: Turning at the last moment clips the posts. Point the nose at the next gate
    while you are still far away.
  controls: arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 2
  spawn: {fileID: 738973680}
  venue: Race track
  recommendedMode: 0
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  gates:
  - {fileID: 928772715}
  - {fileID: 820145991}
  - {fileID: 1554019995}
  - {fileID: 777923220}
  - {fileID: 1643030073}
  - {fileID: 215433317}
  - {fileID: 1541109332}
  - {fileID: 1512210414}
  laps: 1
  bestLapKey: 
  countdownSeconds: 0
  targetLapTime: 0
