MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 797209725}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f07d72465972bb4da76ad5b365e9c55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BalloonPopLesson
  title: Balloon pop
  instructions: 14 balloons are tied around the field at different heights. Fly through
    every one of them - fastest time wins.
  discipline: Demolition
  goal: Fly through all 14 balloons tied around the yard.
  steps:
  - Arm and take off from the pad.
  - Pick the nearest group of balloons, not just the nearest balloon.
  - Fly through each one - touching it pops it.
  - 'Keep moving: your time is scored.'
  skill: Planning an efficient route and hitting a small target in three dimensions.
  tip: Chasing balloons one at a time wastes the clock. Look ahead and link them
    into a route.
  controls: arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 2
  spawn: {fileID: 965371733}
  venue: Demolition yard
  recommendedMode: 0
  parTime: 90
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  balloons:
  - {fileID: 1044177306}
  - {fileID: 1421678915}
  - {fileID: 1562200857}
  - {fileID: 730776784}
  - {fileID: 916528050}
  - {fileID: 136393038}
