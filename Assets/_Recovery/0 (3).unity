--- !u!114 &1988754352
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1988754350}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a87082d4d123cf489e617881f6313ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GateCourseLesson
  title: Gates in ACRO
  instructions: 'Same course in ACRO (press M). No self-levelling: you must actively
    level the drone. Two laps.'
  discipline: Racing
  goal: Fly two laps of the same course in ACRO, where the drone does not level itself.
  steps:
  - Press M until the top-left corner reads ACRO.
  - Arm and lift off with small inputs - it will drift, that is normal.
  - Tap the arrows instead of holding them, and level out after each tap.
  - Complete two laps of the gates.
  skill: Flying without self-levelling - the mode real freestyle and race pilots
    use.
  tip: In ACRO the drone keeps whatever tilt you give it. After every input return
    the stick to centre and level the drone yourself.
  controls: M = switch mode,   arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 4
  spawn: {fileID: 738973680}
  venue: Race track
  recommendedMode: 2
  parTime: 120
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  gates:
  - {fileID: 928772715}
  - {fileID: 820145991}
  - {fileID: 1554019995}
  - {fileID: 777923220}
  - {fileID: 1643030073}
  - {fileID: 215433317}
  - {fileID: 1541109332}
  - {fileID: 1512210414}
  laps: 2
  bestLapKey: 
  countdownSeconds: 0
  targetLapTime: 0
