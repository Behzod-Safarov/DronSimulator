MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1936466256}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f786ee0e27ffab64d8d9e30bc8541d4a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrickLesson
  title: Power loops x2
  instructions: 'ACRO: dive to gain speed, pull up hard and keep pulling over the
    top so you gain 2.5 m or more at the apex, then complete the loop. Two of them.'
  discipline: Freestyle
  goal: 'Do two power loops: dive for speed, then loop up and over the top.'
  steps:
  - ACRO, climb high and dive to build speed.
  - Pull back steadily and keep pulling over the top.
  - You must gain 2.5 m or more at the highest point.
  - Complete the circle and fly out level.
  skill: Trading height for speed and back again - the core of freestyle flying.
  tip: Without enough speed at the bottom you will stall on your back at the top.
    Dive first, then pull.
  controls: M = mode,   up / down arrows = pitch,   W / S = throttle
  difficulty: 5
  spawn: {fileID: 792038976}
  venue: Freestyle park
  recommendedMode: 2
  parTime: 90
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  rollsRequired: 0
  flipsRequired: 0
  loopsRequired: 2
  minAltitude: 6
