MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1950532209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f786ee0e27ffab64d8d9e30bc8541d4a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrickLesson
  title: Flips x3
  instructions: 'ACRO, above 6 m: three full flips (pitch stick fully forward or
    back, hold, centre when level). Punch the throttle just before you start.'
  discipline: Freestyle
  goal: In ACRO, above 6 m, do three full flips.
  steps:
  - ACRO mode, climb above 6 m.
  - Punch the throttle for a moment to gain height.
  - Push the pitch stick fully forward or back and hold it.
  - Catch it level, centre the stick, add throttle.
  skill: The flip - the same catch as a roll, but around the other axis and with
    more height loss.
  tip: A flip drops you further than a roll. Start higher than you think you need
    and punch the throttle just before you begin.
  controls: M = mode,   up / down arrows = pitch,   W / S = throttle
  difficulty: 4
  spawn: {fileID: 1815390324}
  venue: Freestyle park
  recommendedMode: 2
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  rollsRequired: 0
  flipsRequired: 3
  loopsRequired: 0
  minAltitude: 6
