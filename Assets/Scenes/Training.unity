MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1266295531}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a7ea223c931a9714e93fb89f33ac67ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WaterBalloonDropLesson
  title: Water-balloon drop
  instructions: You carry 6 water balloons (they weigh you down). Fly over a bullseye
    and press F to release. The balloon keeps your speed and falls with drag, so
    lead the target. 10 / 5 / 2 points by ring.
  discipline: Demolition
  goal: Drop water balloons onto the three bullseyes. You carry 6.
  steps:
  - Arm and take off - the balloons make the drone heavier.
  - Fly over a bullseye at a steady height.
  - Press F slightly BEFORE you are above the centre.
  - Watch where it lands and correct the next drop. 10 / 5 / 2 points by ring.
  skill: Leading a target - a released load keeps your speed and falls behind you.
  tip: Pressing F right over the target always overshoots. Release before you get
    there, or slow down first.
  controls: F = release a balloon,   arrow keys = tilt,   W / S = throttle
  difficulty: 3
  spawn: {fileID: 2063837930}
  venue: Demolition yard
  recommendedMode: 0
  parTime: 120
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  targets:
  - {fileID: 1308719471}
  - {fileID: 1212749712}
  - {fileID: 1519565595}
  targetRadius: 2
  balloonsPerRun: 6
  balloonMass: 0.12
  rackOffset: {x: 0, y: -0.06, z: 0}
