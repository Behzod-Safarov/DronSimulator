MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 317295254}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a87082d4d123cf489e617881f6313ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GateCourseLesson
  title: Race - 3 laps
  instructions: Wait for the 3-2-1-GO countdown (crossing a gate early is a false
    start), then three timed laps. Your best lap is remembered.
  discipline: Racing
  goal: Wait for the 3-2-1-GO countdown, then fly three timed laps.
  steps:
  - Arm and hover behind the start arch.
  - Wait for GO - do not cross a gate early.
  - Fly three laps, carrying your speed through the gates.
  - Brake by tilting back, not by cutting the throttle.
  skill: Racing under pressure and starting cleanly - your best lap is saved as a
    record.
  tip: Crossing a gate before GO is a false start and restarts the countdown. Hold
    your position until you see GO.
  controls: arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 4
  spawn: {fileID: 196493579}
  venue: Race track
  recommendedMode: 2
  parTime: 150
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  gates:
  - {fileID: 1953979582}
  - {fileID: 664393112}
  - {fileID: 2099732999}
  - {fileID: 1407974806}
  - {fileID: 1215501687}
  - {fileID: 1851563341}
  - {fileID: 1771296419}
  - {fileID: 765734230}
  laps: 3
  bestLapKey: race.bestlap
  countdownSeconds: 3
  targetLapTime: 0
