MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 426053828}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a87082d4d123cf489e617881f6313ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GateCourseLesson
  title: Time trial - beat 22 s
  instructions: Two laps after the countdown. Full marks only if your best lap is
    under 22 seconds - carry speed through the gates, brake with pitch, not throttle.
  discipline: Racing
  goal: Beat 22 seconds on a single lap. You get two laps to try.
  steps:
  - Wait for GO, then build speed along the straight.
  - Enter each turn from the outside and cut close to the inside gate.
  - Keep the drone smooth - every wobble costs time.
  - The better of your two laps counts.
  skill: 'Flying a racing line: wide entry, tight exit, no wasted movement.'
  tip: Full throttle everywhere is slower. Ease off before a turn and add it again
    as you come out.
  controls: M = mode,   arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 5
  spawn: {fileID: 493267913}
  venue: Race track
  recommendedMode: 2
  parTime: 90
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  gates:
  - {fileID: 605340677}
  - {fileID: 416813462}
  - {fileID: 1648880857}
  - {fileID: 1143018795}
  - {fileID: 1853358960}
  - {fileID: 1554154230}
  - {fileID: 86639344}
  - {fileID: 1388897748}
  laps: 2
  bestLapKey: race.bestlap
  countdownSeconds: 3
  targetLapTime: 22
