MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1392259309}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94d57aa61852d79458cdf719ad811dab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LandingLesson
  title: Precision landing
  instructions: Climb above 3 m, then land on the orange H pad softly (under 2 m/s)
    and stay still for 2 seconds. Hard landings break props!
  discipline: Basics
  goal: Climb above 3 m, then land softly on the orange H pad and stay still for
    2 seconds.
  steps:
  - Arm and climb above 3 m.
  - Fly over the orange H pad with small arrow-key nudges.
  - Lower the throttle slightly and let it sink slowly - slower than 2 m/s.
  - Touch down and hold still for 2 seconds.
  skill: Controlled descent and a soft touch-down - the part of every flight that
    breaks props.
  tip: Cutting the throttle to zero over the pad drops the drone. Sink slowly, under
    2 m/s, and keep a little throttle right to the ground.
  controls: W / S = throttle,   arrow keys = tilt,   SPACE = arm
  difficulty: 1
  spawn: {fileID: 0}
  venue: Pit field
  recommendedMode: 0
  parTime: 40
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  pad: {fileID: 1412705868}
  padRadius: 1.2
  climbAltitude: 3
  hardLandingSpeed: 2
  settleSeconds: 2
