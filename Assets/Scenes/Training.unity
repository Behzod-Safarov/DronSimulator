--- !u!114 &857260064
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 857260062}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f786ee0e27ffab64d8d9e30bc8541d4a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrickLesson
  title: Rolls x3
  instructions: Switch to ACRO (M), climb above 6 m, then do three full rolls (roll
    stick all the way, hold, centre when level). Catch each one before it drops.
  discipline: Freestyle
  goal: In ACRO, above 6 m, do three full rolls.
  steps:
  - Press M for ACRO and climb above 6 m.
  - Add a little throttle to gain height before you start.
  - Push the roll stick fully to one side and hold it.
  - The instant the drone is level again, centre the stick and add throttle.
  skill: Throwing and catching a roll - the basic freestyle move.
  tip: Students catch it too late and lose height. Add throttle first, then centre
    the stick the moment the drone is level again.
  controls: M = mode,   left / right arrows = roll,   W / S = throttle
  difficulty: 4
  spawn: {fileID: 1509068482}
  venue: Freestyle park
  recommendedMode: 2
  parTime: 60
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
  rollsRequired: 3
  flipsRequired: 0
  loopsRequired: 0
  minAltitude: 6
