  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 638f4b14d151b75429cd74927a51ef93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DemolitionLesson
  title: Kamikaze demolition
  instructions: Cars, crate towers, barrel pyramids and walls. Demolish 60% of everything
    with 5 drones - pick targets where one blast topples the most.
  discipline: Demolition
  goal: Demolish 60% of the yard using 5 drones.
  steps:
  - 'Look over the yard: cars, crate towers, barrel pyramids and walls.'
  - Pick the target where a single hit topples the most.
  - Hit it low, at the base, with speed.
  - Repeat with your remaining drones until you pass 60%.
  skill: Choosing the target that gives the most result - the same judgement as picking
    a landing spot.
  tip: One drone into one crate is wasted. Aim at the base of a tall stack so the
    whole thing comes down.
  controls: arrow keys = tilt,   A / D = yaw,   W / S = throttle
  difficulty: 4
  spawn: {fileID: 290457019}
  venue: Demolition yard
  recommendedMode: 0
  parTime: 180
  pointsPerSecondOverPar: 0.5
  pointsPerCrash: 15
